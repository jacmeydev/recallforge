{
  "name": "recallforge",
  "version": "1.0.0",
  "description": "Professional spaced repetition system powered by FSRS-5",
  "scripts": {
    "predev": "node scripts/sync-fsrs-browser-assets.js",
    "prebuild": "node scripts/sync-fsrs-browser-assets.js",
    "prestart": "node scripts/sync-fsrs-browser-assets.js",
    "dev": "next dev --webpack --port 3030",
    "dev:https": "next dev --webpack --experimental-https --hostname 0.0.0.0 --port 3030",
    "build": "next build --webpack",
    "start": "next start --port 3030",
    "https:local:up": "bash scripts/local-https-up.sh",
    "https:local:down": "bash scripts/local-https-down.sh",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "bash scripts/run-e2e-docker.sh",
    "test:e2e:local": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:watch": "vitest",
    "db:rehearse": "node scripts/rehearse-migrations.js",
    "db:rollback": "node scripts/rollback-migration.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-virtual": "^3.13.21",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.3.0",
    "drizzle-orm": "^0.45.1",
    "fsrs-browser": "^5.2.0",
    "isomorphic-dompurify": "^3.1.0",
    "lucide-react": "^0.577.0",
    "next": "^16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.5.0",
    "ts-fsrs": "^5.2.3",
    "uuid": "^13.0.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.1.6",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
