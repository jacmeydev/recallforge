# ============================================================================
# RecallForge — optional settings (none are required for local use)
# ============================================================================

# Where your data lives (default: ~/.recallforge/recallforge.db)
# RECALLFORGE_DB=~/.recallforge/recallforge.db

# Require this token on the web app and the API. Only for remote access (see DEPLOYMENT.md).
# RECALLFORGE_TOKEN=

# Public URL shown in the agent connection snippets when exposed through a tunnel.
# BASE_URL=https://recallforge.example.com

# Web app port (default 3030)
# PORT=3030

# Agent API rate limit per IP (requests per window)
# RATE_LIMIT_API_MAX=120
# RATE_LIMIT_WINDOW_MS=60000
