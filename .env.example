# ============================================================================
# RecallForge — Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your values.
# Only AUTH_SECRET is strictly required. Everything else has sensible defaults.
# ============================================================================

# ── Auth (REQUIRED) ─────────────────────────────────────────────────────────
# Secret key for JWT signing. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Trust the host header (set true behind a reverse proxy)
AUTH_TRUST_HOST=true

# ── Database ────────────────────────────────────────────────────────────────
# Path to SQLite database file. Relative to project root or absolute.
# Default: data/recallforge.db
DATABASE_PATH=data/recallforge.db

# ── App ─────────────────────────────────────────────────────────────────────
# Node environment: development | test | production
NODE_ENV=development

# Port the server listens on
PORT=3030

# Public URL agents will use (shown in the connection snippets). Auto-detected if omitted.
# BASE_URL=https://recallforge.example.com

# ── Privacy ─────────────────────────────────────────────────────────────────
# Only the first account can register. Set to true to let others sign up.
ALLOW_REGISTRATION=false

# ── Rate Limiting ───────────────────────────────────────────────────────────
# Auth endpoints: max requests per window (registration, login)
RATE_LIMIT_AUTH_MAX=20

# Agent API: max requests per window per IP (/api/v1 and /api/mcp)
RATE_LIMIT_API_MAX=120

# Window duration in milliseconds (default: 60s)
RATE_LIMIT_WINDOW_MS=60000
